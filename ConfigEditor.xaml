<UserControl x:Class="ConfigEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickIPChange"
             Visibility="Collapsed"
             Focusable="True">
    <!-- 半透明遮罩，覆蓋整個主視窗；點遮罩等同取消 -->
    <Grid Background="{StaticResource OverlayBrush}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border Width="320"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="新增配置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <StackPanel Margin="0,0,0,12">
                    <Label Content="配置名稱"/>
                    <TextBox x:Name="ConfigNameBox" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <Label Content="IP 位址"/>
                    <local:IPAddressControl x:Name="IPBox" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <Label Content="子網路遮罩"/>
                    <local:IPAddressControl x:Name="MaskBox" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <Label Content="預設閘道（可留空）"/>
                    <local:IPAddressControl x:Name="GatewayBox" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <Label Content="慣用 DNS（可留空，不變更）"/>
                    <local:IPAddressControl x:Name="Dns1Box" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <Label Content="其他 DNS（可留空）"/>
                    <local:IPAddressControl x:Name="Dns2Box" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="SaveButton" Content="儲存" Click="Save_Click"
                            Margin="0,0,10,0" Padding="20,8" MinWidth="90"/>
                    <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButton}"
                            Padding="20,8" MinWidth="90"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
