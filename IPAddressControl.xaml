<UserControl x:Class="IPAddressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#1E1E1E" BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Padding="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="Part1" Width="40" MaxLength="3"
                     TextAlignment="Center" BorderThickness="0" Background="Transparent"
                     Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="." VerticalAlignment="Center"
                       Margin="2,0" Foreground="White"/>

            <TextBox Grid.Column="2" x:Name="Part2" Width="40" MaxLength="3"
                     TextAlignment="Center" BorderThickness="0" Background="Transparent"
                     Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="3" Text="." VerticalAlignment="Center"
                       Margin="2,0" Foreground="White"/>

            <TextBox Grid.Column="4" x:Name="Part3" Width="40" MaxLength="3"
                     TextAlignment="Center" BorderThickness="0" Background="Transparent"
                     Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="5" Text="." VerticalAlignment="Center"
                       Margin="2,0" Foreground="White"/>

            <TextBox Grid.Column="6" x:Name="Part4" Width="40" MaxLength="3"
                     TextAlignment="Center" BorderThickness="0" Background="Transparent"
                     Padding="2" VerticalContentAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
