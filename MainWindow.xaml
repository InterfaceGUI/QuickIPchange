<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickIPChange"
        mc:Ignorable="d"
        Title="QuickIPChange - 快速 IP 切換工具"
        Height="800" Width="900"
        MinHeight="720" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：網卡列表 -->
        <Grid Grid.Column="0" Background="{StaticResource SecondaryBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="15,12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="網路介面卡" FontSize="16" FontWeight="SemiBold"/>
            </Border>

            <ListBox Grid.Row="1" x:Name="AdapterListBox" Margin="8"
                     Background="Transparent"
                     SelectionChanged="AdapterListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding AdapterIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplayIPInfo}"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" x:Name="NoAdapterText"
                       Text="找不到實體網卡"
                       Foreground="{StaticResource SecondaryForegroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- 右側：詳細資訊與設定 -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 詳細資訊 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15">
                            <TextBlock x:Name="DetailName" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="DetailDescription" FontSize="12"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <Label Content="IP 位址" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailIP" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,0,0,10">
                            <Label Content="子網路遮罩" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailMask" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                            <Label Content="預設閘道" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailGateway" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="20,0,0,10">
                            <Label Content="DNS 伺服器" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailDns" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,0">
                            <Label Content="MAC 位址" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailMAC" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="20,0,0,0">
                            <Label Content="取得方式" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailMode" Style="{StaticResource DetailValue}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="NoSelectionText"
                               Text="請選擇一個網路介面卡"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,30"/>
                </Grid>
            </Border>

            <!-- 快速切換配置 -->
            <Border Grid.Row="1" x:Name="QuickPanel" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="快速切換配置" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="左鍵套用，右鍵編輯或刪除"
                               FontSize="12" Margin="0,-8,0,10"
                               Foreground="{StaticResource SecondaryForegroundBrush}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="150">
                        <WrapPanel x:Name="QuickConfigPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <Button Content="+ 新增配置"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,12,0,0"
                            Click="AddConfig_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 手動設定 -->
            <Border Grid.Row="3" x:Name="ManualPanel" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                               Text="手動設定 IP" Style="{StaticResource SectionTitle}"/>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <Label Content="IP 位址"/>
                        <local:IPAddressControl x:Name="ManualIP" Margin="0,4,0,12" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <Label Content="子網路遮罩"/>
                        <local:IPAddressControl x:Name="ManualMask" Margin="0,4,0,12" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <Label Content="預設閘道（可留空）"/>
                        <local:IPAddressControl x:Name="ManualGateway" Margin="0,4,0,12" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <Label Content="慣用 DNS（可留空，留空則不變更）"/>
                        <local:IPAddressControl x:Name="ManualDns1" Margin="0,4,0,12" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <Label Content="其他 DNS（可留空）"/>
                        <local:IPAddressControl x:Name="ManualDns2" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button x:Name="ApplyButton" Content="套用設定"
                                Click="ApplyManual_Click"
                                Margin="0,0,10,0"
                                Padding="20,10"/>
                        <Button x:Name="DhcpButton" Content="使用 DHCP"
                                Style="{StaticResource SecondaryButton}"
                                Click="SetDHCP_Click"
                                Padding="20,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
