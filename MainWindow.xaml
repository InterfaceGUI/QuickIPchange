<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickIPChange"
        mc:Ignorable="d"
        Title="QuickIPChange - 快速 IP 切換工具" Height="750" Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D0D">
    <Grid Background="#0D0D0D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：網卡列表 -->
        <Grid Grid.Column="0" Background="#1A1A1A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 標題 -->
            <Border Grid.Row="0" Background="#1E1E1E" Padding="15,12" BorderBrush="#555555" BorderThickness="0,0,0,1">
                <TextBlock Text="網路介面卡" FontSize="16" FontWeight="SemiBold"/>
            </Border>

            <!-- 網卡列表 -->
            <ListBox Grid.Row="1" x:Name="AdapterListBox" Margin="8"
                     SelectionChanged="AdapterListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 網卡圖標 -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding AdapterIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="#fff"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <!-- 網卡資訊 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding DisplayIPInfo}"
                                           FontSize="12"
                                           Foreground="#AAAAAA"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 右側：詳細資訊與設定 -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 詳細資訊區域 -->
            <Border Grid.Row="0" Background="#1E1E1E" Padding="20" CornerRadius="6" Margin="0,0,0,20" BorderBrush="#555555" BorderThickness="1">
                <Grid>
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 網卡名稱 -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   x:Name="DetailName"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- IP 位址 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <Label Content="IP 位址" FontSize="11"/>
                            <TextBlock x:Name="DetailIP" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 子網路遮罩 -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,0,0,10">
                            <Label Content="子網路遮罩" FontSize="11"/>
                            <TextBlock x:Name="DetailMask" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 預設閘道 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                            <Label Content="預設閘道" FontSize="11"/>
                            <TextBlock x:Name="DetailGateway" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- MAC 位址 -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="20,0,0,10">
                            <Label Content="MAC 位址" FontSize="11"/>
                            <TextBlock x:Name="DetailMAC" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 未選擇提示 -->
                    <TextBlock x:Name="NoSelectionText"
                               Text="請選擇一個網路介面卡"
                               FontSize="14"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 快速切換配置區域 -->
            <Border Grid.Row="1" Background="#1E1E1E" Padding="20" CornerRadius="6" Margin="0,0,0,20" BorderBrush="#555555" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="快速切換配置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  MaxHeight="150">
                        <WrapPanel x:Name="QuickConfigPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <Button Content="+ 新增配置"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,12,0,0"
                            Click="AddConfig_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 手動設定區域 -->
            <Border Grid.Row="3" Background="#1E1E1E" Padding="20" CornerRadius="6" BorderBrush="#555555" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                               Text="手動設定 IP"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <!-- IP 位址 -->
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <Label Content="IP 位址"/>
                        <local:IPAddressControl x:Name="ManualIP" Margin="0,4,0,12"/>
                    </StackPanel>

                    <!-- 子網路遮罩 -->
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <Label Content="子網路遮罩"/>
                        <local:IPAddressControl x:Name="ManualMask" Margin="0,4,0,12"/>
                    </StackPanel>

                    <!-- 預設閘道 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" >
                        <Label Content="預設閘道（留空則為 0.0.0.0）"/>
                        <local:IPAddressControl x:Name="ManualGateway" Margin="0,4,0,12"/>
                    </StackPanel>

                    <!-- 按鈕 -->
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="套用設定"
                                Click="ApplyManual_Click"
                                Margin="0,0,10,12"
                                Padding="20,10" VerticalAlignment="Bottom"/>
                        <Button Content="使用 DHCP"
                                Style="{StaticResource SecondaryButton}"
                                Click="SetDHCP_Click"
                                Padding="20,10" VerticalAlignment="Bottom" Margin="0,0,0,12" Cursor=""/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
