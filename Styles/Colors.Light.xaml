<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 淺色主題配色 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1C2430"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#64707F"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DEE6"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EBEFF4"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#DCEAF9"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A7BD1"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C8333A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8E5A"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CAD4"/>
</ResourceDictionary>
